node_modules/
*.log
.DS_Store

# 构建产物与截图（npm run build / tools/cdp.js 生成，可随时重出）
dist/
shots/

# Wrangler 本地状态与密钥（wrangler.jsonc 本身要提交，见该文件注释）
.wrangler/
.dev.vars

# 本地密钥。TypeSafe/Jev 的 API key 走这里（tools/typesafe/ 的客户端会读），
# 绝不能入库。
.env
.env.local
.typesafe-key

# 补编的「打捞产物」：由 tools/recover-from-dist.js 从旧构建里生成，
# 内容已经全在 src/data/ 正册里，随时可重出，不必入库。
# tools/_new/ 下其余 *.json 是补编的原始输入（apply-new-poems.js 读它们），要提交。
tools/_new/recovered.json

# 背景故事的「切分输入」：由 tools/make-story-shards.js 从正册现算，
# 数据一变就过期。真正要留的是写手产出的 story-*.json。
tools/_new/_story-in-*.json

# 探针输出的临时文件（tools/summarize-*.js 读它）
tmp-*.txt

# 外部工具的本地状态 / 脚本。不是本项目的内容。
# 加进忽略而不是删掉：删了就找不回来，忽略掉随时还能用，
# 同时让 `git status` 保持干净。
.reasonix/
.typesafe-smoke.mjs
